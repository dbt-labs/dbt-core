{
  "name": "dbt-docs-web",
  "version": "0.0.0",
  "description": "The dbt docs v2 SPA embedded in the dbt binary by dbt-docs-server",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "vite serve",
    "build": "tsc && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@dbt-labs/biga": "1.7.2",
    "@dbt-labs/dbt-dag": "3.10.0",
    "@dbt-labs/proto": "^1.0.560",
    "@dbt-labs/sourdough": "18.23.0",
    "@dbt-labs/vortex": "^0.3.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "hyparquet": "^1.28.1",
    "hyparquet-compressors": "^1.1.1",
    "lodash": "^4.17.21",
    "pretty-bytes": "^6.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.0.0",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@dbt-labs/eslint-config": "3.0.1",
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.24",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.23.0",
    "happy-dom": "^16.8.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "tailwindcss": "^3.4.0",
    "typescript": "5.9.2",
    "vite": "^6.3.3",
    "vitest": "^3.0.9"
  }
}
